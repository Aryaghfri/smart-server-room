# Jalankan npm run setup -- --mode simulation untuk membuat secret lokal.
APP_MODE=simulation
DATA_DIR=./data
DEVICE_ID=kelapa-esp32-01
DEVICE_API_KEY=
CSRF_SECRET=
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
BASE_URL=http://127.0.0.1:3000
SENSOR_INTERVAL_SECONDS=10
HEARTBEAT_INTERVAL_SECONDS=10
COMMAND_POLL_SECONDS=2
DASHBOARD_POLL_SECONDS=300
OFFLINE_AFTER_SECONDS=30
SENSOR_STALE_SECONDS=30
UNLOCK_TTL_SECONDS=10
RESULT_GRACE_SECONDS=30

# Revisi Oktober: pilih satu sumber aktif, api atau mysql.
DATA_SOURCE=mysql
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=iot_binus
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_TIME_ZONE=+07:00
MYSQL_SSL=false

# Email peringatan asap. Secret SMTP hanya untuk server, tidak untuk browser/ESP32.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
# Penerima peringatan asap yang dibuat otomatis oleh npm run migrate (pisahkan dengan koma).
# Penerima lain bisa ditambah atau dinonaktifkan dari menu Pengaturan di dashboard.
ALERT_RECIPIENTS=spcindonesia@spci.site
